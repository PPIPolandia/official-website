{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "server/data/db.json"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api/|uploads/|sponsors/|assets/).*)",
      "destination": "/index.html"
    }
  ]
}

